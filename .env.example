# StormWatch configuration
# Copy this file to .env and fill in the Required section at minimum.
# See DESIGN.md §9 for the full reference.

# ==============================================================================
# Required
# ==============================================================================

# Your Mosquitto broker
MQTT_HOST=192.168.1.10
# Sent in the User-Agent header, per NWS policy
NWS_CONTACT=you@example.com

# ==============================================================================
# Location
# ==============================================================================
# Defaults to Atlanta, GA if left as-is -- the container still starts and runs
# fine, it just watches the wrong city (and logs a startup warning saying so).
# Set your own city here (geocoded once via the free Open-Meteo API and
# cached to /config/location.json), or use exact LATITUDE/LONGITUDE below --
# recommended over LOCATION for lightning-radius precision, since a city
# geocode lands on the city center, not your exact address. See
# docs/CONFIGURATION.md#location-resolution for the full resolution order.
LOCATION=Atlanta, GA

# ==============================================================================
# Recommended -- exact coordinates (always wins over LOCATION when both set)
# ==============================================================================

# Decimal degrees. Recommended over LOCATION for lightning-radius precision.
# LATITUDE=34.0234
# Decimal degrees. Recommended over LOCATION for lightning-radius precision.
# LONGITUDE=-84.6155

# ==============================================================================
# Common
# ==============================================================================

# MQTT_PORT=1883
# If your broker requires auth
# MQTT_USERNAME=
# If your broker requires auth
# MQTT_PASSWORD=
# imperial or metric
# UNITS=imperial
# In UNITS
# CLOSE_RADIUS=10
# In UNITS
# WATCH_RADIUS=25
# ALL_CLEAR_MINUTES=30
# Comma-separated NWS event names
# ALERTS_CRITICAL=Tornado Warning,Flash Flood Emergency
# Comma-separated NWS event names
# ALERTS_HIGH=Severe Thunderstorm Warning,Flash Flood Warning
# Comma-separated NWS event names
# ALERTS_NORMAL=Tornado Watch,Severe Thunderstorm Watch
# Applies only to rules with quiet_hours: true
# QUIET_HOURS=22:00-07:00
# LOG_LEVEL=INFO

# ==============================================================================
# Optional — Xweather
# ==============================================================================
# Optional — leave blank to stay fully free. Blank = feature off.

# Blank = feature off. Your own key
# XWEATHER_CLIENT_ID=
# XWEATHER_CLIENT_SECRET=
# Only confirm strikes already this close
# XWEATHER_CONFIRM_RADIUS=25
# Under the free allowance on purpose
# XWEATHER_MONTHLY_CALL_LIMIT=1400
# Seconds
# XWEATHER_MIN_CALL_INTERVAL=60

# ==============================================================================
# Advanced
# ==============================================================================

# See §4.1.1
# BLITZORTUNG_MQTT_HOST=blitzortung.ha.sed.pl
# BLITZORTUNG_ENABLED=true
# Non-US users turn this off
# NWS_ENABLED=true
# Floor of 30 enforced
# NWS_POLL_SECONDS=60
# Testing/override; rarely changed
# NWS_API_BASE=https://api.weather.gov
# Path to persistent storage for alert rules and state
# CONFIG_DIR=/config
# Rainfall tracking (forecast + observed accumulation) — on by default, US only (NWS)
# RAIN_ENABLED=true
# Rain forecast poll — seconds between NWS forecast updates
# RAIN_FORECAST_POLL_SECONDS=3600
# Rain observations poll — seconds between NWS observation updates
# RAIN_OBS_POLL_SECONDS=900
# DISCOVERY_PREFIX=homeassistant
# Change if running multiple instances
# DEVICE_NAME=StormWatch
# Minutes of strike history retained for the strikes map entity's geojson attribute; floored at 1
# STRIKE_MAP_WINDOW_MINUTES=30
